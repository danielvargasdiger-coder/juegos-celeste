{
  "rules": {
    "juego": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'"
    },
    "resultados": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'"
    },
    "jugadores": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('unido').val() === now && !newData.child('puntos').exists() && !newData.child('tiempo').exists() && !newData.child('puesto').exists() && !newData.child('ultima').exists()",
        ".validate": "newData.hasChildren(['nombre', 'avatar', 'unido'])",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "unido": {
          ".validate": "newData.isNumber()"
        },
        "puntos": {
          ".validate": "newData.isNumber()"
        },
        "tiempo": {
          ".validate": "newData.isNumber()"
        },
        "puesto": {
          ".validate": "newData.isNumber()"
        },
        "ultima": {
          ".validate": "newData.hasChildren(['pregunta', 'opcion', 'correcta', 'puntos'])"
        },
        "avatar": {
          ".validate": "newData.hasChildren(['i', 'c'])",
          "i": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 19 && newData.val() % 1 === 0"
          },
          "c": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9 && newData.val() % 1 === 0"
          },
          "$otro": {
            ".validate": false
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "respuestas": {
      ".read": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'",
      ".write": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'",
      "$p": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('jugadores/' + $uid).exists() && root.child('juego/estado').val() === 'pregunta' && root.child('juego/clave').val() === $p && now <= root.child('juego/inicio').val() + root.child('juego/duracion').val() + 1500",
          ".validate": "newData.hasChildren(['opcion', 't']) && newData.child('t').val() === now",
          "opcion": {
            ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2 || newData.val() === 3)"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$otro": {
            ".validate": false
          }
        }
      }
    },
    "precio": {
      "juego": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'"
      },
      "resultados": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'"
      },
      "jugadores": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('unido').val() === now && !newData.child('puntos').exists() && !newData.child('tiempo').exists() && !newData.child('puesto').exists() && !newData.child('ultima').exists()",
          ".validate": "newData.hasChildren(['nombre', 'avatar', 'unido'])",
          "nombre": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "unido": {
            ".validate": "newData.isNumber()"
          },
          "puntos": {
            ".validate": "newData.isNumber()"
          },
          "tiempo": {
            ".validate": "newData.isNumber()"
          },
          "puesto": {
            ".validate": "newData.isNumber()"
          },
          "avatar": {
            ".validate": "newData.hasChildren(['i', 'c'])",
            "i": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 19 && newData.val() % 1 === 0"
            },
            "c": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9 && newData.val() % 1 === 0"
            },
            "$otro": {
              ".validate": false
            }
          },
          "ultima": {
            ".validate": "newData.hasChildren(['ronda', 'precio', 'puntos'])"
          },
          "$otro": {
            ".validate": false
          }
        }
      },
      "respuestas": {
        ".read": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'",
        ".write": "auth != null && auth.uid === 'NDjw8ykXMzQ30rFEkP7xrRL3lEu1'",
        "$r": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('precio/jugadores/' + $uid).exists() && root.child('precio/juego/estado').val() === 'ronda' && root.child('precio/juego/clave').val() === $r && now <= root.child('precio/juego/inicio').val() + root.child('precio/juego/duracion').val() + 1500",
            ".validate": "newData.hasChildren(['precio', 't']) && newData.child('t').val() === now",
            "precio": {
              ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 50000000 && newData.val() % 1 === 0"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$otro": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
